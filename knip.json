{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server/handler.ts",
    "server/rotate-ecdh.ts",
    "cdk/bin/main.ts",
    "scripts/generate-masks.ts",
    "scripts/generate-ecdh-key.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "cdk/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["**/*.test.ts"],
  "ignoreBinaries": ["cdk"],
  "exclude": ["types", "nsTypes", "exports"]
}
