{
  "name": "ms-argus-bio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dead-code": "knip",
    "duplication": "jscpd .",
    "quality": "npm run lint && npm run dead-code && npm run duplication",
    "preview": "vite preview",
    "train": "tsx scripts/train.ts",
    "train:emnist": "tsx scripts/train-emnist.ts",
    "build:site": "VITE_API_URL=https://api-bio-dev-jw.argus.pw npm run build",
    "deploy": "npm run build:site && npm run cdk:deploy",
    "cdk:deploy": "npx cdk deploy --require-approval never",
    "cdk:synth": "npx cdk synth",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.12.0",
    "@aws-lambda-powertools/metrics": "^2.12.0",
    "@aws-sdk/client-dynamodb": "^3.989.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.989.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "aws-cdk-lib": "^2.178.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^63.0.0",
    "jscpd": "^4.0.8",
    "knip": "^5.83.1",
    "lefthook": "^2.1.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
